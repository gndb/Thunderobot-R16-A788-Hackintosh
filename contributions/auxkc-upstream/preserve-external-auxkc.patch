diff --git a/tools/test_auxkc.py b/tools/test_auxkc.py
new file mode 100644
index 0000000..a82d37d
--- /dev/null
+++ b/tools/test_auxkc.py
@@ -0,0 +1,145 @@
+#!/usr/bin/env python3
+"""Exercise the real shell helper in temporary roots, with kmutil modeled.
+
+No live kernel collections, Apple payloads or privileged tools are used.
+"""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = (ROOT / 'tools/auxkc.sh').read_text()
+UNINSTALL = (ROOT / 'uninstall.sh').read_text()
+assert 'update_auxkc() {' + SOURCE.split('update_auxkc() {', 1)[1] in UNINSTALL
+subprocess.run(['bash', '-n', str(ROOT / 'tools/auxkc.sh')], check=True)
+subprocess.run(['bash', '-n', str(ROOT / 'uninstall.sh')], check=True)
+
+CASES = (
+    'preserve', 'big-sur', 'duplicate-path', 'no-existing-kc', 'empty-existing',
+    'before-inspect-failed', 'before-format-missing', 'malformed-member',
+    'relative-path', 'missing-bundle', 'create-failed', 'create-no-file',
+    'after-inspect-failed', 'candidate-missing', 'candidate-wrong-version',
+    'candidate-substring', 'candidate-in-boot-only',
+    'table-header-and-blank-lines', 'before-space-member', 'before-unknown-line',
+    'before-extra-field', 'before-duplicate-section', 'before-parent-path',
+    'before-double-slash-path', 'before-missing-path', 'after-space-member',
+    'after-extra-field', 'after-duplicate-section', 'after-format-missing',
+    'candidate-numeric-version-alias',
+)
+SUCCESS = {'preserve', 'big-sur', 'duplicate-path', 'no-existing-kc', 'empty-existing',
+           'table-header-and-blank-lines'}
+
+MOCK = r'''import json, os, sys
+from pathlib import Path
+name = Path(sys.argv[0]).name
+args = sys.argv[1:]
+case = os.environ['XE_TEST_CASE']
+with open(os.environ['XE_TEST_LOG'], 'a') as stream:
+    stream.write(json.dumps([name, args]) + '\n')
+if name == 'sw_vers':
+    print('11.7.11' if case == 'big-sur' else '26.7')
+    sys.exit(0)
+if name != 'kmutil': sys.exit(99)
+target = Path(args[args.index('-A') + 1])
+if args[0] == 'create':
+    if case == 'create-failed': sys.exit(27)
+    if case != 'create-no-file': target.write_bytes(b'new-kc')
+    sys.exit(0)
+if args[0] != 'inspect': sys.exit(99)
+before = str(target) == os.environ['XE_TEST_LIVE']
+if before and case == 'before-inspect-failed': sys.exit(28)
+if not before and case == 'after-inspect-failed': sys.exit(29)
+external = os.environ['XE_TEST_EXTERNAL']
+local = os.environ['XE_TEST_LOCAL']
+print('boot kernel collection at fixture:')
+if (before and case == 'before-format-missing') or (not before and case == 'after-format-missing'): sys.exit(0)
+if not before and case == 'candidate-in-boot-only':
+    print('org.example.DeviceSupport\t4.0\t' + external + '\t')
+print('system kernel collection at fixture:')
+print('auxiliary kext collection at fixture:')
+if case == 'table-header-and-blank-lines':
+    print('Extension Information:')
+    print('')
+    print('   ')
+print('org.example.Local\t1.0\t' + local + '\t')
+if before and case == 'empty-existing': sys.exit(0)
+if before and case == 'malformed-member':
+    print('org.example.DeviceSupport\t\t' + external)
+    sys.exit(0)
+if before and case == 'relative-path': external = 'relative/Device Support.kext'
+if before and case == 'before-parent-path': external = str(Path(local).parent) + '/../Device Support.kext'
+if before and case == 'before-double-slash-path': external = external.replace('/Apple/', '//Apple/')
+if before and case == 'before-missing-path':
+    print('org.example.DeviceSupport\t4.0\t')
+    sys.exit(0)
+if before and case == 'before-unknown-line':
+    print('unrecognized inspection text')
+    sys.exit(0)
+if (before and case == 'before-space-member') or (not before and case == 'after-space-member'):
+    print('org.example.DeviceSupport 4.0 ' + external)
+    sys.exit(0)
+if not before and case in ('candidate-missing', 'candidate-in-boot-only'): sys.exit(0)
+identifier = 'org.example.DeviceSupport.extra' if not before and case == 'candidate-substring' else 'org.example.DeviceSupport'
+version = '4.0'
+if not before and case == 'candidate-wrong-version': version = '4.1'
+if not before and case == 'candidate-numeric-version-alias': version = '4.00'
+print(identifier + '\t' + version + '\t' + external + '\t')
+if (before and case == 'before-extra-field') or (not before and case == 'after-extra-field'):
+    print('org.example.Other\t1.0\t' + external + '\tunexpected')
+if (before and case == 'before-duplicate-section') or (not before and case == 'after-duplicate-section'):
+    print('auxiliary kext collection at duplicate:')
+if before and case == 'duplicate-path':
+    print(identifier + '\t' + version + '\t' + external + '\t')
+'''
+
+for case in CASES:
+    with tempfile.TemporaryDirectory(prefix='xe-auxkc-test-') as tmp:
+        root = Path(tmp)
+        library = root / 'Library'
+        system = root / 'System/Library'
+        live = library / 'KernelCollections/AuxiliaryKernelExtensions.kc'
+        live.parent.mkdir(parents=True)
+        if case != 'no-existing-kc': live.write_bytes(b'previous-kc')
+        local = library / 'Extensions/Local.kext'
+        local.mkdir(parents=True)
+        external = library / 'Apple/System/Library/Extensions/Device Support.kext'
+        if case != 'missing-bundle': external.mkdir(parents=True)
+        log = root / 'calls.jsonl'
+        mock = root / 'mock.py'
+        mock.write_text('#!' + sys.executable + '\n' + MOCK)
+        mock.chmod(0o755)
+        body = SOURCE.replace('/System/Library/', '/__SYSTEM__/')
+        body = body.replace('/Library/', str(library) + '/')
+        body = body.replace('/__SYSTEM__/', str(system) + '/')
+        for tool in ('/usr/bin/sw_vers', '/usr/bin/kmutil'):
+            link = root / Path(tool).name
+            link.symlink_to(mock)
+            body = body.replace(tool, str(link))
+        script = root / 'exercise.sh'
+        script.write_text('set -euo pipefail\n' + body + '\nupdate_auxkc\n')
+        env = dict(os.environ, XE_TEST_CASE=case, XE_TEST_LOG=str(log),
+                   XE_TEST_LIVE=str(live), XE_TEST_EXTERNAL=str(external),
+                   XE_TEST_LOCAL=str(local))
+        result = subprocess.run(['bash', str(script)], env=env,
+                                capture_output=True, text=True)
+        calls = [json.loads(line) for line in log.read_text().splitlines()]
+        creates = [args for name, args in calls if name == 'kmutil' and args[0] == 'create']
+        if case in SUCCESS:
+            assert result.returncode == 0, (case, result.stderr)
+            assert live.read_bytes() == b'new-kc', case
+            assert live.stat().st_mode & 0o777 == 0o644, case
+            assert len(creates) == 1, case
+            paths = [creates[0][i + 1] for i, arg in enumerate(creates[0]) if arg == '-p']
+            expected = [str(local)] if case in ('no-existing-kc', 'empty-existing') else [str(local), str(external)]
+            assert paths == expected, (case, paths, expected)
+        else:
+            assert result.returncode != 0, case
+            assert live.read_bytes() == b'previous-kc', case
+        if creates:
+            assert ('--allow-missing-kdk' in creates[0]) == (case != 'big-sur'), case
+        assert not list(live.parent.glob('.WhateverXe.*')), case
+        print('PASS:', case)
+print(f'PASS: {len(CASES)} AuxKC shell cases; kmutil modeled; no live cache changes')
